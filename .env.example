# ============================================================================
# Coherence — environment configuration
# Copy this file to `.env` and fill in ONE free LLM provider (all optional).
# The engine runs fully WITHOUT any LLM key (deterministic NBA classifier);
# a key only unlocks the AI auto-classification + plain-language explanations.
# ============================================================================

# --- LLM provider (pick ONE free option, or leave blank to run AI-free) ------
# Supported values: groq | gemini | openrouter | ollama | none
LLM_PROVIDER=none

# Groq (free, very fast) — get a key at https://console.groq.com/keys
# GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier) — get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# OpenRouter (has :free models) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama (fully local, free, offline) — https://ollama.com
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1

# --- Market data (Polymarket public APIs — no key needed for read access) ----
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# --- Strategy / risk parameters ----------------------------------------------
# Minimum net edge (after fees + slippage) required to act, as a probability gap
MIN_EDGE=0.02
# Fraction of full Kelly to size at (0.25 = quarter-Kelly, conservative)
KELLY_FRACTION=0.25
# Hard cap on capital deployed per single market leg (USD)
MAX_STAKE_PER_LEG=50
# Total paper bankroll (USD)
BANKROLL=1000
# Taker fee assumption (Polymarket is currently 0 bps; keep a buffer)
TAKER_FEE_BPS=0
# Poll interval for the live automation loop (ms)
POLL_INTERVAL_MS=15000

# --- Execution mode -----------------------------------------------------------
# paper = simulate fills against the LIVE order book (default, safe)
# live  = place real CLOB orders (requires wallet + API creds; NOT needed for demo)
EXECUTION_MODE=paper
